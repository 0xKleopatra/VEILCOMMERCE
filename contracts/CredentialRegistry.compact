pragma language_version >= 0.22;

import CompactStandardLibrary;

// =============================================================================
// VeilCommerce — CredentialRegistry (Private Credentials + Nullifiers)
// -----------------------------------------------------------------------------
// Credence pattern: private credentials, selective disclosure, nullifiers.
//
// Stores credential commitments; revocation via nullifier set. Supports:
//   - issuing credentials (admin/issuer)
//   - proving knowledge of credential without revealing it
//   - selective disclosure to verifier (auditor, counterparty, financier)
//   - revocation checks
//   - replay protection via nullifiers
//
// Private: credential preimage, holder secret, salt
// Public : credentialId, commitment, issuerId, holderCommit, revoked flag,
//          expiry, nullifiers
// =============================================================================

export enum CredentialType { BusinessRegistration, TaxId, TradeLicense, BankStatement, ComplianceCert, Other }
export enum CredentialStatus { Active, Revoked, Expired, Suspended }

export struct HolderSecret {
  bytes: Bytes<32>;
}

struct CredentialRecord {
  credentialId: Bytes<32>;
  holderId: Bytes<32>;
  issuerId: Bytes<32>;
  credentialType: CredentialType;
  commitment: Bytes<32>;
  status: CredentialStatus;
  issuedAt: Uint<64>;
  expiresAt: Uint<64>;
}

struct CredentialPreimage {
  holderSecret: Bytes<32>;
  credentialType: CredentialType;
  issuedAt: Uint<64>;
  salt: Bytes<32>;
}

// Ledger
export ledger totalCredentials: Counter;
export ledger credentials: Map<Bytes<32>, CredentialRecord>;
export ledger credentialExists: Set<Bytes<32>>;
export ledger revokedCredentials: Set<Bytes<32>>;
export ledger holderCredentials: Map<Bytes<32>, Set<Bytes<32>>>;
export ledger usedCredentialNullifiers: Set<Bytes<32>>;
export ledger trustedIssuers: Set<Bytes<32>>;

// Sealed admin
sealed ledger credentialAdmin: Bytes<32>;

// Witnesses
witness getHolderSecret(): HolderSecret;
witness getIssuerSecret(): HolderSecret;
witness credentialSalt(): Bytes<32>;
witness credentialIssuedAt(): Uint<64>;

// Helpers
pure circuit deriveHolderId(sk: HolderSecret): Bytes<32> {
  return persistentHash<Vector<2, Bytes<32>>>([
    pad(32, "veil:cred:holder:v1"),
    sk.bytes
  ]);
}

pure circuit deriveIssuerId(sk: HolderSecret): Bytes<32> {
  return persistentHash<Vector<2, Bytes<32>>>([
    pad(32, "veil:cred:issuer:v1"),
    sk.bytes
  ]);
}

pure circuit computeCredentialCommitment(preimage: CredentialPreimage): Bytes<32> {
  return persistentHash<CredentialPreimage>(preimage);
}

pure circuit computePresentationNullifier(sk: HolderSecret, credentialId: Bytes<32>, verifierId: Bytes<32>): Bytes<32> {
  return persistentHash<Vector<3, Bytes<32>>>([
    sk.bytes,
    credentialId,
    verifierId
  ]);
}

constructor() {
  const adminSecret = getIssuerSecret();
  credentialAdmin = disclose(deriveIssuerId(adminSecret));
  trustedIssuers.insert(disclose(credentialAdmin));
}

// Admin: add trusted issuer
export circuit addTrustedIssuer(issuerId: Bytes<32>): [] {
  const adminSecret = getIssuerSecret();
  assert(disclose(deriveIssuerId(adminSecret) == credentialAdmin), "Only admin");
  trustedIssuers.insert(disclose(issuerId));
}

// Issue credential — issuer creates commitment for holder
export circuit issueCredential(
  credentialId: Bytes<32>,
  holderId: Bytes<32>,
  credentialType: CredentialType,
  expiresAt: Uint<64>,
  timestamp: Uint<64>
): [] {
  const disclosedId = disclose(credentialId);
  assert(disclose(!credentialExists.member(disclosedId)), "Credential already exists");

  const issuerSecret = getIssuerSecret();
  const issuerId = deriveIssuerId(issuerSecret);
  assert(disclose(trustedIssuers.member(disclose(issuerId))), "Issuer not trusted");

  const salt = credentialSalt();
  const issuedAt = credentialIssuedAt();
  const preimage = CredentialPreimage {
    holderSecret: holderId,
    credentialType: credentialType,
    issuedAt: issuedAt,
    salt: salt
  };
  const commitment = computeCredentialCommitment(preimage);

  const record = CredentialRecord {
    credentialId: credentialId,
    holderId: holderId,
    issuerId: issuerId,
    credentialType: credentialType,
    commitment: commitment,
    status: CredentialStatus.Active,
    issuedAt: timestamp,
    expiresAt: expiresAt
  };

  credentials.insert(disclosedId, disclose(record));
  credentialExists.insert(disclosedId);
  totalCredentials.increment(1);
}

// Holder proves they own the credential — ZK: know preimage that hashes to commitment
export circuit proveCredential(
  credentialId: Bytes<32>,
  verifierId: Bytes<32>
): Boolean {
  const disclosedId = disclose(credentialId);
  assert(disclose(credentialExists.member(disclosedId)), "Credential not found");
  assert(disclose(!revokedCredentials.member(disclosedId)), "Credential revoked");
  const rec = credentials.lookup(disclosedId);
  assert(disclose(rec.status == CredentialStatus.Active), "Not active");

  const holderSecret = getHolderSecret();
  const holderId = deriveHolderId(holderSecret);
  assert(disclose(holderId == rec.holderId), "Not holder");

  const salt = credentialSalt();
  const issuedAt = credentialIssuedAt();
  const preimage = CredentialPreimage {
    holderSecret: holderId,
    credentialType: rec.credentialType,
    issuedAt: issuedAt,
    salt: salt
  };
  const recomputed = computeCredentialCommitment(preimage);
  assert(disclose(recomputed == rec.commitment), "Credential proof failed");

  // Selective disclosure nullifier — prevents replay to same verifier
  const nullifier = computePresentationNullifier(holderSecret, credentialId, verifierId);
  assert(disclose(!usedCredentialNullifiers.member(disclose(nullifier))), "Presentation already used");
  usedCredentialNullifiers.insert(disclose(nullifier));

  return true;
}

// Lightweight check without nullifier consumption (for verification queries)
export circuit verifyCredential(
  credentialId: Bytes<32>
): Boolean {
  const disclosedId = disclose(credentialId);
  if (!credentialExists.member(disclosedId)) { return false; }
  if (revokedCredentials.member(disclosedId)) { return false; }
  const rec = credentials.lookup(disclosedId);
  return rec.status == CredentialStatus.Active;
}

export circuit revokeCredential(credentialId: Bytes<32>): [] {
  const issuerSecret = getIssuerSecret();
  const issuerId = deriveIssuerId(issuerSecret);
  const disclosedId = disclose(credentialId);
  assert(disclose(credentialExists.member(disclosedId)), "Credential not found");
  const rec = credentials.lookup(disclosedId);
  const isIssuer = issuerId == rec.issuerId;
  const isAdmin = issuerId == credentialAdmin;
  assert(isIssuer || isAdmin, "Only issuer or admin");
  revokedCredentials.insert(disclosedId);
}

export circuit suspendCredential(credentialId: Bytes<32>): [] {
  const issuerSecret = getIssuerSecret();
  const issuerId = deriveIssuerId(issuerSecret);
  const disclosedId = disclose(credentialId);
  assert(disclose(credentialExists.member(disclosedId)), "Credential not found");
  const rec = credentials.lookup(disclosedId);
  const isIssuer = issuerId == rec.issuerId;
  const isAdmin = issuerId == credentialAdmin;
  assert(isIssuer || isAdmin, "Only issuer or admin");
  const updated = CredentialRecord {
    credentialId: rec.credentialId,
    holderId: rec.holderId,
    issuerId: rec.issuerId,
    credentialType: rec.credentialType,
    commitment: rec.commitment,
    status: CredentialStatus.Suspended,
    issuedAt: rec.issuedAt,
    expiresAt: rec.expiresAt
  };
  credentials.insert(disclosedId, disclose(updated));
}

// Reads
export circuit getCredential(credentialId: Bytes<32>): CredentialRecord {
  const disclosedId = disclose(credentialId);
  assert(disclose(credentialExists.member(disclosedId)), "Credential not found");
  return credentials.lookup(disclosedId);
}

export circuit isRevoked(credentialId: Bytes<32>): Boolean {
  return revokedCredentials.member(disclose(credentialId));
}

export circuit commitmentOf(credentialId: Bytes<32>): Bytes<32> {
  const disclosedId = disclose(credentialId);
  assert(disclose(credentialExists.member(disclosedId)), "Credential not found");
  return credentials.lookup(disclosedId).commitment;
}