pragma language_version >= 0.22;

import CompactStandardLibrary;

// =============================================================================
// VeilCommerce — Proof of Financing Eligibility Circuit
// -----------------------------------------------------------------------------
// Proves: invoice meets financing criteria without revealing
// sensitive financial data.
//
// Criteria verified:
//   - Invoice is valid and acknowledged
//   - Delivery was verified
//   - Buyer is creditworthy
//   - Seller has sufficient credit score
//   - Invoice not previously financed
//   - Risk requirements met
//
// Used by: Financing contract (requestFinancing, verifyRisk)
// =============================================================================

export struct FinancingProofInput {
  // Invoice details (private)
  invoice_amount: Uint<64>;
  invoice_status: Uint<8>;        // 0=issued, 1=acknowledged, 2=settled, 3=voided
  delivery_verified: Boolean;
  buyer_credit_score: Uint<16>;
  seller_credit_score: Uint<16>;
  invoice_age_days: Uint<16>;
  
  // Financing parameters (public)
  min_buyer_score: Uint<16>;
  min_seller_score: Uint<16>;
  max_invoice_age_days: Uint<16>;
  financing_ratio_bps: Uint<16>;  // e.g., 9000 = 90%
}

export struct FinancingProofOutput {
  eligible: Boolean;
  max_financing_amount: Uint<64>;
  financing_commitment: Bytes<32>;
  risk_score: Uint<16>;
}

struct FinancingData {
  invoice_amount: Uint<64>;
  invoice_status: Uint<8>;
  delivery_verified: Boolean;
  buyer_credit_score: Uint<16>;
  seller_credit_score: Uint<16>;
  invoice_age_days: Uint<16>;
}

pure circuit commitFinancing(data: FinancingData): Bytes<32> {
  return persistentHash<FinancingData>(data);
}

pure circuit computeRiskScore(input: FinancingProofInput): Uint<16> {
  let score: Uint<16> = 0;
  
  // Invoice status (0=issued, 1=acknowledged) - max 25 points
  if (input.invoice_status == 1) { // acknowledged
    score = score + 25;
  } else if (input.invoice_status == 0) { // issued
    score = score + 10;
  }
  
  // Delivery verified - max 25 points
  if (input.delivery_verified) {
    score = score + 25;
  }
  
  // Buyer credit score - max 25 points
  if (input.buyer_credit_score >= input.min_buyer_score) {
    score = score + 25;
  }
  
  // Seller credit score - max 25 points
  if (input.seller_credit_score >= input.min_seller_score) {
    score = score + 25;
  }
  
  return score;
}

export circuit proveFinancingEligibility(input: FinancingProofInput): FinancingProofOutput {
  const risk_score = computeRiskScore(input);
  const eligible = risk_score >= 70 && input.invoice_age_days <= input.max_invoice_age_days;
  
  const max_financing = (input.invoice_amount * input.financing_ratio_bps) / 10000;
  
  const commitment = commitFinancing(FinancingData {
    invoice_amount: input.invoice_amount,
    invoice_status: input.invoice_status,
    delivery_verified: input.delivery_verified,
    buyer_credit_score: input.buyer_credit_score,
    seller_credit_score: input.seller_credit_score,
    invoice_age_days: input.invoice_age_days
  });
  
  return FinancingProofOutput {
    eligible: eligible,
    max_financing_amount: max_financing,
    financing_commitment: commitment,
    risk_score: risk_score
  };
}

export circuit verifyFinancingProof(
  financing_commitment: Bytes<32>,
  input: FinancingProofInput
): Boolean {
  const recomputed = commitFinancing(FinancingData {
    invoice_amount: input.invoice_amount,
    invoice_status: input.invoice_status,
    delivery_verified: input.delivery_verified,
    buyer_credit_score: input.buyer_credit_score,
    seller_credit_score: input.seller_credit_score,
    invoice_age_days: input.invoice_age_days
  });
  const matches = recomputed == financing_commitment;
  const risk_score = computeRiskScore(input);
  const eligible = risk_score >= 70 && input.invoice_age_days <= input.max_invoice_age_days;
  return matches && eligible;
}