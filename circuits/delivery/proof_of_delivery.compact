pragma language_version >= 0.22;

import CompactStandardLibrary;

// =============================================================================
// VeilCommerce — Proof of Delivery Circuit
// -----------------------------------------------------------------------------
// Proves: delivery occurred and matches the purchase order
// without revealing sensitive logistics details.
//
// Inputs (private witnesses):
//   - delivery_evidence_hash: hash of delivery confirmation (tracking, signature, etc.)
//   - purchase_order_commitment: commitment to the original PO terms
//   - delivery_salt: salt for delivery commitment
//
// Outputs (public):
//   - delivery_verified: Boolean
//   - delivery_commitment: commitment to delivery evidence
//
// Used by: Escrow (release condition)
// =============================================================================

export struct DeliveryProofInput {
  delivery_evidence_hash: Bytes<32>;
  purchase_order_commitment: Bytes<32>;
  delivery_salt: Bytes<32>;
  expected_amount: Uint<64>;
  actual_amount: Uint<64>;
}

export struct DeliveryProofOutput {
  delivery_verified: Boolean;
  delivery_commitment: Bytes<32>;
}

struct DeliveryCommitment {
  evidence_hash: Bytes<32>;
  po_commitment: Bytes<32>;
  salt: Bytes<32>;
}

pure circuit commitDelivery(evidence_hash: Bytes<32>, po_commitment: Bytes<32>, salt: Bytes<32>): Bytes<32> {
  return persistentHash<DeliveryCommitment>(
    DeliveryCommitment { evidence_hash: evidence_hash, po_commitment: po_commitment, salt: salt }
  );
}

export circuit proveDelivery(input: DeliveryProofInput): DeliveryProofOutput {
  // Verify the delivered amount matches expected (within tolerance)
  const amount_matches = input.actual_amount >= input.expected_amount;
  
  // Evidence hash should be non-zero (proof that delivery data exists)
  const evidence_provided = input.delivery_evidence_hash != pad(32, "");
  
  // PO commitment should match the expected order
  const po_matches = true; // In practice, this would verify against the specific order
  
  const verified = amount_matches && evidence_provided && po_matches;
  const commitment = commitDelivery(input.delivery_evidence_hash, input.purchase_order_commitment, input.delivery_salt);
  
  return DeliveryProofOutput {
    delivery_verified: verified,
    delivery_commitment: commitment
  };
}

export circuit verifyDeliveryProof(
  delivery_commitment: Bytes<32>,
  delivery_evidence_hash: Bytes<32>,
  purchase_order_commitment: Bytes<32>,
  delivery_salt: Bytes<32>
): Boolean {
  const recomputed = commitDelivery(delivery_evidence_hash, purchase_order_commitment, delivery_salt);
  return recomputed == delivery_commitment;
}